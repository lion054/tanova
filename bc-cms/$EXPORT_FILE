INSERT INTO `bc_tours` (id,title,slug,content,image_id,banner_image_id,short_desc,category_id,location_id,address,map_lat,map_lng,map_zoom,is_featured,gallery,video,price,sale_price,duration,time_slot,zone,activity_type,available_months,available_days,tsokanew_id,min_people,max_people,faqs,status,publish_date,create_user,update_user,deleted_at,origin_id,lang,created_at,updated_at,default_state,enable_fixed_date,start_date,end_date,last_booking_date,include,exclude,itinerary,review_score,ical_import_url,enable_service_fee,service_fee,surrounding,author_id,booking_type,limit_type,capacity_type,capacity,pass_exprire_type,pass_exprire_at,pass_valid_for,date_select_type,min_day_before_booking,is_package) VALUES ('410','13-Day Cultural-Wildlife Safari','13-day-cultural-wildlife-safari','<div style=\'font-family:Arial,sans-serif;\'><h1 style=\'color:#FF6B35; font-size:28px; margin:0 0 10px 0;\'>Where Culture Meets Wildlife</h1><p style=\'font-size:15px; color:#555; margin:15px 0; line-height:1.8;\'>Authentic Tanzania where wildlife and culture intertwine. Visit Hadzabe hunter-gatherers, explore Maasai traditions, witness predators in Serengeti, and descend into Africa\'s greatest crater.</p><div style=\'background:#f9f5ec; padding:12px; border-radius:6px; margin:20px 0; border-left:4px solid #FF6B35;\'><strong>Highlights:</strong><br><span>Tarangire Elephant Herds • Lake Eyasi Hadzabe Hunters • Serengeti Predators • Ngorongoro Crater UNESCO Site • Maasai Cultural Visits • Big Five Sightings • 2-3 Game Drives Daily</span></div><h3 style=\'color:#2ECC71; margin:25px 0 10px 0; border-bottom:2px solid #2ECC71; padding-bottom:8px;\'>✓ What\'s Included</h3><p>Expert guides • Park fees • 4x4 vehicles • All meals • Quality lodges • Ground transport • Hadzabe experience • Maasai visits • Multiple game drives • Binoculars • Water and drinks</p><h3 style=\'color:#E74C3C; margin:25px 0 10px 0; border-bottom:2px solid #E74C3C; padding-bottom:8px;\'>✗ What\'s NOT Included</h3><p>International flights • Travel insurance • Visa • Alcohol • Tips • Personal items • Single supplement • Optional activities</p></div>',NULL,NULL,'Multi-day Safari package - 11 days from Tanzania - Safari & Culture','4','14','TanzaniaSafari & Culture',NULL,NULL,NULL,NULL,NULL,NULL,'3250.00',NULL,'110','1','2',NULL,NULL,NULL,NULL,NULL,NULL,'[{\"title\":\"Will we definitely see the Big Five?\",\"content\":\"We have 90%+ sighting rates for lion, elephant, buffalo, and leopard. Black rhino is harder (50%) but possible. Multiple drives increase chances.\"},{\"title\":\"What is the Hadzabe experience like?\",\"content\":\"You\'ll spend an afternoon with Hadzabe people. Learn their click-language, observe traditional hunting, and share meals. Authentic and culturally respectful exchange.\"},{\"title\":\"Is this good for photographers?\",\"content\":\"Excellent! Professional guides position vehicles for optimal lighting. They know animal behavior and movement patterns for best shots.\"},{\"title\":\"Can children participate?\",\"content\":\"Yes! Children 5+ are welcome. Game drives suit all ages with proper sun protection. Cultural visits are educational and safe.\"},{\"title\":\"What is the daily schedule?\",\"content\":\"Early start (5:30am) for morning game drive, breakfast 8am, rest midday, afternoon drive 3pm-sunset, dinner and rest. Flexible pace throughout.\"},{\"title\":\"How many animals will we see?\",\"content\":\"Expect 150+ species on average. Serengeti alone has 1,500+ lions. Daily encounters with numerous species guaranteed throughout the safari.\"}]','publish',NULL,'9',NULL,NULL,NULL,NULL,'2026-05-31 17:08:05','2026-05-31 17:08:05','1','0',NULL,NULL,NULL,'[\"Expert safari guides (naturalist trained)\",\"All national park entrance fees\",\"4x4 Land Cruiser (one per 4-6 guests)\",\"All meals (breakfast, lunch, dinner)\",\"Quality lodge accommodations\",\"Ground transportation\",\"Hadzabe cultural experience\",\"Maasai village visits with traditional meals\",\"Multiple game drives daily (2-3 per day)\",\"Binoculars and field identification guides\",\"Daily bottled water and soft drinks\",\"First aid and emergency support\",\"Photography guidance and support\"]','[\"International flights\",\"Travel insurance\",\"Tanzania visa (US $50-100)\",\"Alcoholic beverages\",\"Tips and gratuities (10-15% suggested)\",\"Personal items and souvenirs\",\"Single room supplement\",\"Optional activities beyond itinerary\"]','[{\"title\":\"Day 1: Arrival & Mt. Meru\",\"desc\":\"Welcome to Tanzania\",\"content\":\"Arrive at Kilimanjaro Airport. Meet your guide and transfer to Mt. Meru Game Lodge. Evening safari orientation and welcome dinner.\"},{\"title\":\"Day 2-3: Tarangire National Park\",\"desc\":\"Elephant herds & game drives\",\"content\":\"Full days exploring Tarangire. See giant elephant herds, baobab trees, and prolific birdlife. Two game drives daily (morning and afternoon).\"},{\"title\":\"Day 4: Lake Manyara\",\"desc\":\"Tree-climbing lions & baboons\",\"content\":\"Drive to Lake Manyara. Game drive to see tree-climbing lions, baboons, and waterbirds. Drive toward Lake Eyasi.\"},{\"title\":\"Day 5: Hadzabe Hunter-Gatherers\",\"desc\":\"Meet bushmen, click-language\",\"content\":\"Afternoon hike to meet Hadzabe people. Learn click-language, observe traditional hunting techniques. Share cultural exchange with the last true hunter-gatherers.\"},{\"title\":\"Day 6-8: Serengeti National Park\",\"desc\":\"Predators & migration viewing\",\"content\":\"Three full days in Serengeti. Multiple game drives daily. See lions, leopards, cheetahs. Witness wildebeest migration (June-October).\"},{\"title\":\"Day 9: Ngorongoro Crater Rim\",\"desc\":\"Transfer & Maasai village visit\",\"content\":\"Drive from Serengeti to Ngorongoro. Visit Maasai village with traditional lunch. Overnight near crater rim.\"},{\"title\":\"Day 10: Crater Descent & Big Five\",\"desc\":\"UNESCO site, 600m descent\",\"content\":\"Descend 600m into crater. Game drive to spot resident Big Five (lion, elephant, buffalo, rhino, leopard). Afternoon ascent.\"},{\"title\":\"Day 11: West Kilimanjaro Transfer\",\"desc\":\"Game walk & night drive\",\"content\":\"Transfer to Ndarakwai in West Kilimanjaro. Afternoon game walk and night game drive to spot nocturnal animals.\"},{\"title\":\"Day 12: Ndarakwai Activities\",\"desc\":\"Game drives, walk, Maasai boma\",\"content\":\"Full day at Ndarakwai: morning game drive, guided forest walk, optional Maasai boma visit, evening night drive.\"},{\"title\":\"Day 13: Departure\",\"desc\":\"Return to Kilimanjaro Airport\",\"content\":\"Breakfast and transfer to Kilimanjaro International Airport. Depart with memories of authentic Tanzania.\"}]',NULL,NULL,NULL,NULL,NULL,'9',NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,'0');
INSERT INTO `bc_tours` (id,title,slug,content,image_id,banner_image_id,short_desc,category_id,location_id,address,map_lat,map_lng,map_zoom,is_featured,gallery,video,price,sale_price,duration,time_slot,zone,activity_type,available_months,available_days,tsokanew_id,min_people,max_people,faqs,status,publish_date,create_user,update_user,deleted_at,origin_id,lang,created_at,updated_at,default_state,enable_fixed_date,start_date,end_date,last_booking_date,include,exclude,itinerary,review_score,ical_import_url,enable_service_fee,service_fee,surrounding,author_id,booking_type,limit_type,capacity_type,capacity,pass_exprire_type,pass_exprire_at,pass_valid_for,date_select_type,min_day_before_booking,is_package) VALUES ('411','10-Day Signature Safari','10-day-signature-safari','<div style=\'font-family:Arial,sans-serif;\'><h1 style=\'color:#FF6B35; font-size:28px; margin:0 0 10px 0;\'>Best of Tanzania - Curated & Proven</h1><p style=\'font-size:15px; color:#555; margin:15px 0; line-height:1.8;\'>Our most popular safari. Perfectly balanced to hit all highlights: coffee culture, game-rich parks, crater descent, and Maasai encounters. Highest guest satisfaction.</p><div style=\'background:#f9f5ec; padding:12px; border-radius:6px; margin:20px 0; border-left:4px solid #FF6B35;\'><strong>Highlights:</strong><br><span>Materuni Coffee Culture • Tarangire Elephants • Lake Eyasi Hadzabe • Serengeti Migration • Big Five Viewing • Ngorongoro Crater • Maasai Traditions</span></div><h3 style=\'color:#2ECC71; margin:25px 0 10px 0; border-bottom:2px solid #2ECC71; padding-bottom:8px;\'>✓ What\'s Included</h3><p>Professional guides • All park fees • 4x4 vehicles • All meals • Comfortable lodges • Ground transport • Coffee farm tour • Waterfall swim • Hadzabe experience • Bottled water</p><h3 style=\'color:#E74C3C; margin:25px 0 10px 0; border-bottom:2px solid #E74C3C; padding-bottom:8px;\'>✗ What\'s NOT Included</h3><p>International flights • Travel insurance • Visa • Alcohol • Tips • Personal items • Single supplement • Zanzibar flights</p></div>',NULL,NULL,'Multi-day Safari package - 9 days from Tanzania - Northern Circuit','4','14','TanzaniaNorthern Circuit',NULL,NULL,NULL,NULL,NULL,NULL,'2995.00',NULL,'90','1','2',NULL,NULL,NULL,NULL,NULL,NULL,'[{\"title\":\"Why is this our most popular tour?\",\"content\":\"Perfect balance of time vs experiences. No rushing, no boring days. You see everything important without exhaustion. Ideal for first-time African safari visitors.\"},{\"title\":\"Can I extend to Zanzibar?\",\"content\":\"Yes! Add 3-4 days in Zanzibar (flight $250pp). Enjoy pristine beaches, Stone Town historic tours, spice markets, and ocean activities.\"},{\"title\":\"What\'s the best time to book?\",\"content\":\"June-October for wildlife, November-May for scenery and fewer tourists. Book 2-3 months ahead for best availability and rates.\"},{\"title\":\"How active is this safari?\",\"content\":\"Mostly sitting in vehicle enjoying views. Occasional walks (30 min-1 hour). Hiking at Materuni waterfall is optional. Very comfortable level.\"},{\"title\":\"Are guides really knowledgeable?\",\"content\":\"Yes. All guides are trained naturalists with 5-10+ years experience. They know animals, plants, geology, history, and culture intimately.\"},{\"title\":\"What if we don\'t see something?\",\"content\":\"We have 95%+ sighting rates for main attractions. If something is missed, we adjust the itinerary next day to try again.\"}]','publish',NULL,'9',NULL,NULL,NULL,NULL,'2026-05-31 17:08:05','2026-05-31 17:08:05','1','0',NULL,NULL,NULL,'[\"Professional safari guides\",\"All park entrance fees\",\"4x4 Land Cruiser vehicles\",\"All meals (breakfast, lunch, dinner)\",\"Lodge accommodations\",\"Ground transportation\",\"Coffee farm and cultural tours\",\"Waterfall visit and swim\",\"Hadzabe cultural experience\",\"Maasai village visit\",\"Multiple game drives daily\",\"Bottled water and soft drinks\",\"First aid support\"]','[\"International flights\",\"Travel insurance\",\"Visa (US $50-100)\",\"Alcohol (beer\\/wine available for purchase)\",\"Tips (10-15% suggested)\",\"Personal items\",\"Single room supplement\",\"Zanzibar extension flights\"]','[{\"title\":\"Day 1: Arrival in Arusha\",\"desc\":\"Welcome to Tanzania\",\"content\":\"Arrive at Kilimanjaro Airport. Transfer to Arusha. Evening briefing and preparation for your safari adventure.\"},{\"title\":\"Day 2: Materuni Waterfall & Culture\",\"desc\":\"Coffee farm, waterfall swim\",\"content\":\"Drive to Materuni. Visit Chaga coffee farm and learn coffee processing. Visit waterfall and swim in natural pools. Enjoy traditional Chaga lunch.\"},{\"title\":\"Day 3: Tarangire National Park\",\"desc\":\"Elephant herds & game drive\",\"content\":\"Drive to Tarangire. Full day game drive. See giant elephant herds, baobab trees, and prolific birdlife. Camp overnight at park edge.\"},{\"title\":\"Day 4: Lake Eyasi & Hadzabe\",\"desc\":\"Hunter-gatherer experience\",\"content\":\"Drive to Lake Eyasi. Meet Hadzabe bushmen. Learn their click-language and traditional hunting methods. Evening drive back.\"},{\"title\":\"Day 5-6: Serengeti Game Drives\",\"desc\":\"Predators & migration\",\"content\":\"Two full days in Serengeti. Multiple game drives daily. Lions, leopards, cheetahs. Wildebeest migration (June-October). Stay at comfortable Serengeti lodge.\"},{\"title\":\"Day 7: Serengeti to Ngorongoro\",\"desc\":\"Crater arrival\",\"content\":\"Final morning Serengeti game drive. Drive to Ngorongoro. Visit Maasai village with traditional lunch. Overnight near crater rim.\"},{\"title\":\"Day 8-9: Ngorongoro Crater\",\"desc\":\"UNESCO site & Big Five\",\"content\":\"Descend into crater for full-day exploration. Game drive to spot resident Big Five. Optional crater rim hike. Second day for extended crater exploration or cultural visits.\"},{\"title\":\"Day 10: Departure\",\"desc\":\"Return to Arusha\",\"content\":\"Morning transfer back to Arusha. Visit Shanga market for last-minute shopping. Afternoon transfer to Kilimanjaro Airport for departure. Optional Zanzibar extension available.\"}]',NULL,NULL,NULL,NULL,NULL,'9',NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,'0');
INSERT INTO `bc_tours` (id,title,slug,content,image_id,banner_image_id,short_desc,category_id,location_id,address,map_lat,map_lng,map_zoom,is_featured,gallery,video,price,sale_price,duration,time_slot,zone,activity_type,available_months,available_days,tsokanew_id,min_people,max_people,faqs,status,publish_date,create_user,update_user,deleted_at,origin_id,lang,created_at,updated_at,default_state,enable_fixed_date,start_date,end_date,last_booking_date,include,exclude,itinerary,review_score,ical_import_url,enable_service_fee,service_fee,surrounding,author_id,booking_type,limit_type,capacity_type,capacity,pass_exprire_type,pass_exprire_at,pass_valid_for,date_select_type,min_day_before_booking,is_package) VALUES ('412','6-Day Fly-Out Safari','6-day-fly-out-safari','<div style=\'font-family:Arial,sans-serif;\'><h1 style=\'color:#FF6B35; font-size:28px; margin:0 0 10px 0;\'>Complete Safari in 6 Days</h1><p style=\'font-size:15px; color:#555; margin:15px 0; line-height:1.8;\'>Condensed yet comprehensive. Perfect for time-limited travelers. Hit all major highlights: Tarangire, Ngorongoro Crater, and Serengeti with optional fly-out to Zanzibar.</p><div style=\'background:#f9f5ec; padding:12px; border-radius:6px; margin:20px 0; border-left:4px solid #FF6B35;\'><strong>Highlights:</strong><br><span>Tarangire Elephants • Ngorongoro Crater Big Five • Serengeti Game Drives • Fly-Out Option • Fast-Paced Itinerary</span></div><h3 style=\'color:#2ECC71; margin:25px 0 10px 0; border-bottom:2px solid #2ECC71; padding-bottom:8px;\'>✓ What\'s Included</h3><p>Professional guides • All park fees • 4x4 vehicles • All meals • Comfortable lodges • Ground transport • Multiple game drives • Bottled water</p><h3 style=\'color:#E74C3C; margin:25px 0 10px 0; border-bottom:2px solid #E74C3C; padding-bottom:8px;\'>✗ What\'s NOT Included</h3><p>International flights • Travel insurance • Visa • Alcohol • Tips • Personal items • Single supplement • Zanzibar flights</p></div>',NULL,NULL,'Multi-day Safari package - 5 days from Tanzania - Central Safari','4','14','TanzaniaCentral Safari',NULL,NULL,NULL,NULL,NULL,NULL,'1495.00',NULL,'50','1','2',NULL,NULL,NULL,NULL,NULL,NULL,'[{\"title\":\"Is 6 days enough?\",\"content\":\"Yes! This itinerary hits all major highlights efficiently. No wasted time, maximum wildlife viewing. Perfect for time-limited travelers.\"},{\"title\":\"Why the scenic flight?\",\"content\":\"The flight showcases Tanzania\'s geography magnificently. You see the Serengeti from above and arrive refreshed. A memorable end to your safari.\"},{\"title\":\"What about wildlife sightings?\",\"content\":\"Excellent chances! With game drives in Tarangire, Ngorongoro, and Serengeti, you\'ll see diverse species and the Big Five.\"},{\"title\":\"Can I skip the flight?\",\"content\":\"Yes, you can drive back instead. The flight adds cost but saves 5 hours of travel. Optional based on your preference and schedule.\"}]','publish',NULL,'9',NULL,NULL,NULL,NULL,'2026-05-31 17:08:05','2026-05-31 17:08:05','1','0',NULL,NULL,NULL,'[\"Professional guides\",\"Park entrance fees\",\"4x4 vehicles\",\"All meals\",\"Lodge accommodations\",\"Ground transportation\",\"Multiple game drives\",\"Scenic flight (Serengeti to Arusha)\",\"Bottled water and drinks\",\"First aid support\"]','[\"International flights\",\"Travel insurance\",\"Visa\",\"Alcohol\",\"Tips (suggested 10-15%)\",\"Personal items\",\"Optional activities\"]','[{\"title\":\"Day 1: Arrival & Tarangire\",\"desc\":\"Transfer & afternoon game drive\",\"content\":\"Arrive at Kilimanjaro Airport. Transfer to Tarangire National Park. Afternoon game drive to see elephant herds and baobabs. Overnight at park lodge.\"},{\"title\":\"Day 2: Tarangire Exploration\",\"desc\":\"Full day game viewing\",\"content\":\"Full day exploring Tarangire. Morning and afternoon game drives. Giant elephant concentrations, unique baobab trees, diverse birdlife. Evening return to lodge.\"},{\"title\":\"Day 3: Ngorongoro Crater\",\"desc\":\"UNESCO site & Big Five\",\"content\":\"Drive to Ngorongoro Crater. Descend 600m into UNESCO World Heritage crater. Game drive to spot Big Five. Witness Maasai cattle herding. Overnight on rim.\"},{\"title\":\"Day 4-5: Serengeti Safari\",\"desc\":\"Predators & game drives\",\"content\":\"Two days in Serengeti. Multiple game drives daily. Lions, leopards, cheetahs on the vast plains. Seasonal migration viewing (June-October). Comfortable Serengeti lodge.\"},{\"title\":\"Day 6: Fly-Out to Arusha\\/Zanzibar\",\"desc\":\"Final game drive & flight\",\"content\":\"Early morning final game drive. Transfer to airstrip. Scenic flight from Serengeti to Arusha (or optional to Zanzibar). Arrive with unforgettable memories.\"}]',NULL,NULL,NULL,NULL,NULL,'9',NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,'0');
INSERT INTO `bc_tours` (id,title,slug,content,image_id,banner_image_id,short_desc,category_id,location_id,address,map_lat,map_lng,map_zoom,is_featured,gallery,video,price,sale_price,duration,time_slot,zone,activity_type,available_months,available_days,tsokanew_id,min_people,max_people,faqs,status,publish_date,create_user,update_user,deleted_at,origin_id,lang,created_at,updated_at,default_state,enable_fixed_date,start_date,end_date,last_booking_date,include,exclude,itinerary,review_score,ical_import_url,enable_service_fee,service_fee,surrounding,author_id,booking_type,limit_type,capacity_type,capacity,pass_exprire_type,pass_exprire_at,pass_valid_for,date_select_type,min_day_before_booking,is_package) VALUES ('413','13-Day Photographic Safari','13-day-photographic-safari','<div style=\'font-family:Arial,sans-serif;\'><h1 style=\'color:#FF6B35; font-size:28px; margin:0 0 10px 0;\'>Photography-Focused Safari</h1><p style=\'font-size:15px; color:#555; margin:15px 0; line-height:1.8;\'>Designed for photographers. Professional guidance for composition, lighting, and wildlife behavior. Multiple drives per day with optimal photography times.</p><div style=\'background:#f9f5ec; padding:12px; border-radius:6px; margin:20px 0; border-left:4px solid #FF6B35;\'><strong>Highlights:</strong><br><span>Professional Photo Guidance • Multiple Daily Drives • Sunrise & Sunset Photography • Wildlife Behavior Insight • Landscape Composition • Big Five Sightings • Extended Serengeti Time</span></div><h3 style=\'color:#2ECC71; margin:25px 0 10px 0; border-bottom:2px solid #2ECC71; padding-bottom:8px;\'>✓ What\'s Included</h3><p>Photography-trained guides • All park fees • 4x4 vehicles • All meals • Comfort lodges • Ground transport • Professional photo coaching • Extended game drives • Bottled water</p><h3 style=\'color:#E74C3C; margin:25px 0 10px 0; border-bottom:2px solid #E74C3C; padding-bottom:8px;\'>✗ What\'s NOT Included</h3><p>International flights • Travel insurance • Visa • Alcohol • Tips • Personal items • Single supplement</p></div>',NULL,NULL,'Multi-day Safari package - 9 days from Tanzania - Photography Focus','4','14','TanzaniaPhotography Focus',NULL,NULL,NULL,NULL,NULL,NULL,'3500.00',NULL,'90','1','2',NULL,NULL,NULL,NULL,NULL,NULL,'[{\"title\":\"Do I need professional camera equipment?\",\"content\":\"No! Guides work with all levels. However, telephoto lenses (200-400mm) and good ISO performance are helpful. Guides advise on composition regardless of equipment.\"},{\"title\":\"What camera settings do you recommend?\",\"content\":\"For wildlife: ISO 400-3200, shutter speed 1\\/500+, aperture f\\/5.6-8 depending on light. Guides provide coaching specific to your equipment.\"},{\"title\":\"Are there extra photo drives?\",\"content\":\"Yes! 3-4 game drives per day (more than other safaris). Early starts for golden hour. Late afternoon for sunset photography.\"},{\"title\":\"Can I learn post-processing?\",\"content\":\"Guides discuss field techniques and composition. Some lodges offer basic post-processing workshops. Bring your laptop if interested.\"},{\"title\":\"How will guides help with photography?\",\"content\":\"Professional photography-trained guides position vehicles for optimal angles, advise on exposure, predict animal behavior, and suggest composition improvements.\"}]','publish',NULL,'9',NULL,NULL,NULL,NULL,'2026-05-31 17:08:05','2026-05-31 17:08:05','1','0',NULL,NULL,NULL,'[\"Photography-trained guides\",\"All park fees\",\"4x4 vehicles with optimal positioning\",\"All meals\",\"Quality lodges\",\"Ground transport\",\"Professional photo coaching\",\"Multiple daily game drives (3-4)\",\"Extended morning\\/sunset drives\",\"Photo guidance at every drive\",\"Bottled water and drinks\",\"First aid support\"]','[\"International flights\",\"Travel insurance\",\"Visa\",\"Alcohol\",\"Tips (suggested 10-15%)\",\"Camera equipment rental\",\"Post-processing workshops (unless arranged)\",\"Photo printing services\"]','[{\"title\":\"Day 1: Arrival in Arusha\",\"desc\":\"Photography briefing\",\"content\":\"Arrive at Kilimanjaro Airport. Transfer to Arusha. Evening briefing on photography during safari\\u2014composition, lighting, and wildlife behavior for optimal shots.\"},{\"title\":\"Day 2: Tarangire Photography\",\"desc\":\"Multiple photo drives\",\"content\":\"Day drive to Tarangire. Two game drives with professional photography guidance. Golden hour shooting at sunrise and sunset. Photograph elephant herds and baobabs.\"},{\"title\":\"Day 3: Tarangire Extended\",\"desc\":\"Varied habitats & lighting\",\"content\":\"Full day photographic drives through varied habitats. Sunset shots, raptors and big game at the river. Professional guidance on composition and settings.\"},{\"title\":\"Day 4: Lake Manyara & Eyasi\",\"desc\":\"Game drive & cultural photography\",\"content\":\"Game drive at Lake Manyara for tree-climbing lions and waterbirds. Drive to Lake Eyasi. Photograph Hadzabe people and their hunting culture.\"},{\"title\":\"Day 5-7: Serengeti Photography\",\"desc\":\"Three days of game photography\",\"content\":\"Three full days in Serengeti. Multiple game drives daily (3-4 per day). Photograph predators hunting, lions on plains, migration crossings. Professional coaching on every drive.\"},{\"title\":\"Day 8: Serengeti Extended\",\"desc\":\"Special lighting conditions\",\"content\":\"Continue Serengeti game photography. Focus on special lighting conditions, animal behavior patterns, and composition techniques. Best angles for big game.\"},{\"title\":\"Day 9: Northern Serengeti\",\"desc\":\"Migration & river crossings\",\"content\":\"Drive to northern Serengeti for Mara River crossings (June-October). Photograph dramatic migration scenes, predator-prey interactions. Professional positioning for shots.\"},{\"title\":\"Day 10-11: Serengeti Return & Ngorongoro\",\"desc\":\"Return south & crater photography\",\"content\":\"Drive back to central Serengeti for one more photography session. Transfer to Ngorongoro. Descend crater for distinctive photography angles. Unique crater floor composition.\"},{\"title\":\"Day 12: Crater Extended\",\"desc\":\"Varied crater photography\",\"content\":\"Full day crater photography. Big Five in natural habitat. Unique lighting in crater bowl. Maasai herds as photo subjects. Professional guidance throughout.\"},{\"title\":\"Day 13: Departure\",\"desc\":\"Return to Arusha\",\"content\":\"Return to Arusha. Visit photo printing\\/enhancement services if interested. Transfer to Kilimanjaro Airport with remarkable photographic portfolio.\"}]',NULL,NULL,NULL,NULL,NULL,'9',NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,'0');
INSERT INTO `bc_tours` (id,title,slug,content,image_id,banner_image_id,short_desc,category_id,location_id,address,map_lat,map_lng,map_zoom,is_featured,gallery,video,price,sale_price,duration,time_slot,zone,activity_type,available_months,available_days,tsokanew_id,min_people,max_people,faqs,status,publish_date,create_user,update_user,deleted_at,origin_id,lang,created_at,updated_at,default_state,enable_fixed_date,start_date,end_date,last_booking_date,include,exclude,itinerary,review_score,ical_import_url,enable_service_fee,service_fee,surrounding,author_id,booking_type,limit_type,capacity_type,capacity,pass_exprire_type,pass_exprire_at,pass_valid_for,date_select_type,min_day_before_booking,is_package) VALUES ('414','24-Day A Sense of Adventure','24-day-a-sense-of-adventure','<div style=\'font-family:Arial,sans-serif;\'><h1 style=\'color:#FF6B35; font-size:28px; margin:0 0 10px 0;\'>The Ultimate Tanzanian Experience</h1><p style=\'font-size:15px; color:#555; margin:15px 0; line-height:1.8;\'>Experience everything Tanzania has to offer. From Mount Kilimanjaro to Lake Victoria, Serengeti to coastal beaches—this is the complete journey.</p><div style=\'background:#f9f5ec; padding:12px; border-radius:6px; margin:20px 0; border-left:4px solid #FF6B35;\'><strong>Highlights:</strong><br><span>West Kilimanjaro • Lake Natron Flamingos • Serengeti Migration • Lake Victoria Boating • Ngorongoro Crater • Lake Eyasi Hadzabe • Mkomazi Black Rhinos • Lushoto Highland Trekking • Pangani Beach • Dar es Salaam Coast</span></div><h3 style=\'color:#2ECC71; margin:25px 0 10px 0; border-bottom:2px solid #2ECC71; padding-bottom:8px;\'>✓ What\'s Included</h3><p>Professional guides • All park fees • 4x4 vehicles • All meals • Premium lodges • Ground transport • Lake Victoria boats • Deep-sea fishing • Cultural experiences • Photography support • Daily water and drinks • First aid</p><h3 style=\'color:#E74C3C; margin:25px 0 10px 0; border-bottom:2px solid #E74C3C; padding-bottom:8px;\'>✗ What\'s NOT Included</h3><p>International flights • Travel insurance • Visa • Alcohol • Tips (10-15% suggested) • Personal items • Single supplement • Pre-trek accommodation</p></div>',NULL,NULL,'Multi-day Adventure package - 24 days from Tanzania - Complete Experience','4','14','TanzaniaComplete Experience',NULL,NULL,NULL,NULL,NULL,NULL,'5995.00',NULL,'240','1','2',NULL,NULL,NULL,NULL,NULL,NULL,'[{\"title\":\"What is included in this 24-day package?\",\"content\":\"Professional guides, all park entrance fees, 4x4 vehicles, all meals, quality lodges throughout, ground transportation, and all listed activities including Lake Victoria boats and deep-sea fishing.\"},{\"title\":\"Is this suitable for families?\",\"content\":\"Yes! The itinerary is family-friendly. Children 5+ can participate. Activities are diverse with mix of game drives (sitting in vehicle), cultural visits, and relaxation.\"},{\"title\":\"How much wildlife will we see?\",\"content\":\"Extensive! Multiple game drives in each location, seasonal migration viewing in Serengeti, Big Five in Ngorongoro, plus 200+ species sightings estimated.\"},{\"title\":\"What about comfort and accommodations?\",\"content\":\"Premium lodges throughout with private bathrooms, hot showers, good beds, fine dining. This is comfortable adventure travel, not camping.\"},{\"title\":\"Can I customize the itinerary?\",\"content\":\"Yes! We can adjust activities, accommodation types, or focus areas. Contact us for custom options.\"},{\"title\":\"What is the best time to visit?\",\"content\":\"June-October (dry season) offers best game viewing. November-May (green season) has fewer tourists and beautiful scenery.\"},{\"title\":\"Is it safe for solo travelers?\",\"content\":\"Yes, all activities are group-based with professional guides. Excellent safety record. Female travelers welcome.\"}]','publish',NULL,'9',NULL,NULL,NULL,NULL,'2026-05-31 17:08:05','2026-05-31 17:08:05','1','0',NULL,NULL,NULL,'[{\"title\":\"Professional safari guides (naturalist trained)\"},{\"title\":\"All national park entrance fees\"},{\"title\":\"4x4 Land Cruiser (one per 4-6 guests)\"},{\"title\":\"All meals (breakfast, lunch, dinner)\"},{\"title\":\"Quality lodge accommodations throughout\"},{\"title\":\"All ground transportation\"},{\"title\":\"Lake Victoria boat trips\"},{\"title\":\"Deep-sea fishing equipment and crew\"},{\"title\":\"Hadzabe cultural experience\"},{\"title\":\"Maasai village visits\"},{\"title\":\"Daily bottled water and soft drinks\"},{\"title\":\"First aid and emergency support\"},{\"title\":\"Professional photography guidance\"}]','[{\"title\":\"International airfare to\\/from Tanzania\"},{\"title\":\"Travel insurance (required)\"},{\"title\":\"Tanzania visa (US $50-100)\"},{\"title\":\"Alcoholic beverages\"},{\"title\":\"Tips and gratuities (10-15% suggested)\"},{\"title\":\"Personal items and souvenirs\"},{\"title\":\"Single room supplement\"},{\"title\":\"Optional activities beyond itinerary\"},{\"title\":\"Medical expenses and medications\"},{\"title\":\"Personal travel documents\"}]','[{\"image_id\":null,\"title\":\"Day 1: Kilimanjaro Airport\",\"desc\":\"Welcome to Tanzania\",\"content\":\"Arrive at JRO, meet your guide. Transfer to your lodge near Mount Kilimanjaro. Evening briefing about the adventure ahead.\"},{\"image_id\":null,\"title\":\"Day 2-3: West Kilimanjaro\",\"desc\":\"Farm experience & hiking\",\"content\":\"Visit a working farm, learn about Maasai culture. Hike to Shira Plateau with stunning views over Tanzanian plains.\"},{\"image_id\":null,\"title\":\"Day 4-5: Lake Natron\",\"desc\":\"Flamingos & volcanic landscape\",\"content\":\"Drive to Lake Natron. See thousands of pink flamingos. Explore volcanic hot springs and scenic landscape.\"},{\"image_id\":null,\"title\":\"Day 6-8: Serengeti Deep Dive\",\"desc\":\"Multiple game drives & migration\",\"content\":\"Three full days exploring the Serengeti. Multiple game drives daily. Witness predator hunting and seasonal migration (June-October).\"},{\"image_id\":null,\"title\":\"Day 9-11: Lake Victoria\",\"desc\":\"Boat trips & fishing\",\"content\":\"Relax at Africa\'s largest lake. Boat trips, fishing, bird watching. Experience local fish markets and culture on the shores.\"},{\"image_id\":null,\"title\":\"Day 12-13: Ngorongoro Crater\",\"desc\":\"UNESCO crater descent\",\"content\":\"Descend 600m into UNESCO World Heritage crater. See resident Big Five. Witness Maasai cattle herding in the crater floor.\"},{\"image_id\":null,\"title\":\"Day 14-15: Lake Eyasi & Tarangire\",\"desc\":\"Hadzabe experience & elephants\",\"content\":\"Meet Hadzabe hunter-gatherers. Learn their traditions and hunting techniques. Then explore Tarangire\'s elephant herds.\"},{\"image_id\":null,\"title\":\"Day 16-18: Mkomazi & Lushoto\",\"desc\":\"Black rhinos & highland trekking\",\"content\":\"See endangered black rhinos and wild dogs in Mkomazi. Trek through Lushoto highlands with forest walks and waterfalls.\"},{\"image_id\":null,\"title\":\"Day 19-20: Pangani Beach\",\"desc\":\"Deep-sea fishing & relaxation\",\"content\":\"Relax on pristine Pangani beach. Deep-sea fishing for marlin and tuna. Fresh seafood dinners on the Indian Ocean.\"},{\"image_id\":null,\"title\":\"Day 21-24: Dar es Salaam\",\"desc\":\"Coastal culture & departure\",\"content\":\"Visit Saadani National Park (only park with Indian Ocean beach). Explore coastal Dar es Salaam. Final relaxation before departure.\"}]',NULL,NULL,NULL,NULL,NULL,'9',NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,'0');
INSERT INTO `bc_tours` (id,title,slug,content,image_id,banner_image_id,short_desc,category_id,location_id,address,map_lat,map_lng,map_zoom,is_featured,gallery,video,price,sale_price,duration,time_slot,zone,activity_type,available_months,available_days,tsokanew_id,min_people,max_people,faqs,status,publish_date,create_user,update_user,deleted_at,origin_id,lang,created_at,updated_at,default_state,enable_fixed_date,start_date,end_date,last_booking_date,include,exclude,itinerary,review_score,ical_import_url,enable_service_fee,service_fee,surrounding,author_id,booking_type,limit_type,capacity_type,capacity,pass_exprire_type,pass_exprire_at,pass_valid_for,date_select_type,min_day_before_booking,is_package) VALUES ('415','11-Day Women\'s Programme','11-day-womens-programme','<div style=\'font-family:Arial,sans-serif;\'><h1 style=\'color:#FF6B35; font-size:28px; margin:0 0 10px 0;\'>Safari for Women Explorers</h1><p style=\'font-size:15px; color:#555; margin:15px 0; line-height:1.8;\'>Specially curated safari featuring women-led camps (Dunia Camp in Serengeti), community partnerships, cultural exchanges, and empowerment initiatives.</p><div style=\'background:#f9f5ec; padding:12px; border-radius:6px; margin:20px 0; border-left:4px solid #FF6B35;\'><strong>Highlights:</strong><br><span>Women-Led Camps • Agape Women\'s Project • Walking Safaris • Maasai Boma Visits • Cultural Exchange • Community Partnership • Female-Friendly Accommodations</span></div><h3 style=\'color:#2ECC71; margin:25px 0 10px 0; border-bottom:2px solid #2ECC71; padding-bottom:8px;\'>✓ What\'s Included</h3><p>Expert guides • All park fees • 4x4 vehicles • All meals • Quality lodges • Ground transport • Women project visit • Maasai visits • Walking safaris • Bottled water</p><h3 style=\'color:#E74C3C; margin:25px 0 10px 0; border-bottom:2px solid #E74C3C; padding-bottom:8px;\'>✗ What\'s NOT Included</h3><p>International flights • Travel insurance • Visa • Alcohol • Tips • Personal items • Single supplement</p></div>',NULL,NULL,'Multi-day Safari package - 11 days from Tanzania - Women Explorers','4','14','TanzaniaWomen Explorers',NULL,NULL,NULL,NULL,NULL,NULL,'2750.00',NULL,'110','1','2',NULL,NULL,NULL,NULL,NULL,NULL,'[{\"title\":\"Is this only for women?\",\"content\":\"Yes, this program celebrates women travelers and female-led tourism. All guides and key staff are women. Men can book other safaris; this one is reserved for women.\"},{\"title\":\"What makes it special?\",\"content\":\"Female guides bring unique perspectives. Dunia Camp is all-female-run. You\'ll meet female entrepreneurs, Maasai women leaders, and conservation researchers\\u2014genuine female empowerment experiences.\"},{\"title\":\"Is it safe for solo women travelers?\",\"content\":\"Absolutely! This program is designed specifically for women travelers. All staff are female. Group activities are structured, transportation is secure, and guides are trained in safety.\"},{\"title\":\"Will we discuss women\'s issues?\",\"content\":\"Yes, naturally. Conversations with female guides, Maasai women, and entrepreneurs provide insights into women\'s lives, challenges, and achievements in Tanzania.\"},{\"title\":\"What about the physical activity level?\",\"content\":\"Moderate to active. Game drives (sitting), 1-2 hour walking safari, general hiking. No strenuous climbing. Most participants find it very enjoyable and not overly taxing.\"}]','publish',NULL,'9',NULL,NULL,NULL,NULL,'2026-05-31 17:08:05','2026-05-31 17:08:05','1','0',NULL,NULL,NULL,'[\"Female professional guides\",\"All-female support staff\",\"All park entrance fees\",\"4x4 vehicles (female drivers)\",\"All meals\",\"All-female accommodations\\/camps\",\"Agape women\'s project visit\",\"Maasai boma visit & cultural learning\",\"Dunia Camp (all-female-run)\",\"Walking safari with female rangers\",\"Multiple game drives daily\",\"Bottled water and drinks\",\"Female-centered hospitality\"]','[\"International flights\",\"Travel insurance\",\"Visa\",\"Alcohol\",\"Tips (suggested 10-15%)\",\"Personal items\",\"Men travelers (reserved for women)\",\"Optional beyond-itinerary activities\"]','[{\"title\":\"Day 1: Arrival Arusha\",\"desc\":\"Welcome for women travelers\",\"content\":\"Arrive Kilimanjaro Airport. Transfer to Arusha. Meet female guide and female support staff. Evening orientation in welcoming, safe environment.\"},{\"title\":\"Day 2: Agape Women\'s Project\",\"desc\":\"Support local women\",\"content\":\"Visit Agape women\'s project in Mulala village. Coffee roasting, honey production, traditional crafts. Support local female entrepreneurs. Traditional lunch.\"},{\"title\":\"Day 3: Lake Manyara\",\"desc\":\"Game drive & culture\",\"content\":\"Game drive at Lake Manyara. See tree-climbing lions, baboons, waterbirds. Meet female Maasai guides sharing their perspective on wildlife and culture.\"},{\"title\":\"Day 4: Ngorongoro Preparations\",\"desc\":\"Maasai boma visit\",\"content\":\"Visit Maasai boma (traditional village). Learn about women\'s roles in Maasai society, their crafts, cooking, and family life. Afternoon drive to crater.\"},{\"title\":\"Day 5: Empakai Crater Walk\",\"desc\":\"Women-led walking safari\",\"content\":\"Walking safari through Empakai Conservation Area with female Maasai rangers. Descend to crater lake. See blue monkeys and flamingos. Female-focused outdoor adventure.\"},{\"title\":\"Day 6: Ngorongoro Crater\",\"desc\":\"UNESCO site descent\",\"content\":\"Descend 600m into Ngorongoro crater. Female guides lead game drive. Spot Big Five. Learn about women\'s conservation efforts in the crater.\"},{\"title\":\"Day 7: Serengeti Transfer\",\"desc\":\"Drive to women-led camp\",\"content\":\"Drive to Dunia Camp in Serengeti\\u2014the only all-female-run safari camp in the Serengeti. All staff female. Female-centered hospitality and services.\"},{\"title\":\"Day 8: Serengeti Game Drive\",\"desc\":\"Female-guided wildlife viewing\",\"content\":\"Full day at Dunia Camp. Morning and afternoon game drives led by female naturalist guides. See predators, herbivores, bird species. Evening fireside discussion.\"},{\"title\":\"Day 9: Serengeti Movement\",\"desc\":\"Migration & predators\",\"content\":\"Full day exploring Serengeti. Photograph migration (June-October). Watch predator-prey interactions. Learn about women conservation researchers working in the region.\"},{\"title\":\"Day 10: Seronera River\",\"desc\":\"River valley exploration\",\"content\":\"Game drive along Seronera River Valley. Spot lions, leopards, large herbivores. Scenic drive through diverse habitats. Professional female guide expertise.\"},{\"title\":\"Day 11: Departure\",\"desc\":\"Return & celebration\",\"content\":\"Return to Arusha. Celebrate your safari journey with the team. Share experiences and photos. Transfer to Kilimanjaro Airport with empowered heart and mind.\"}]',NULL,NULL,NULL,NULL,NULL,'9',NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,'0');
INSERT INTO `bc_tours` (id,title,slug,content,image_id,banner_image_id,short_desc,category_id,location_id,address,map_lat,map_lng,map_zoom,is_featured,gallery,video,price,sale_price,duration,time_slot,zone,activity_type,available_months,available_days,tsokanew_id,min_people,max_people,faqs,status,publish_date,create_user,update_user,deleted_at,origin_id,lang,created_at,updated_at,default_state,enable_fixed_date,start_date,end_date,last_booking_date,include,exclude,itinerary,review_score,ical_import_url,enable_service_fee,service_fee,surrounding,author_id,booking_type,limit_type,capacity_type,capacity,pass_exprire_type,pass_exprire_at,pass_valid_for,date_select_type,min_day_before_booking,is_package) VALUES ('416','5-Day Marangu Trek','5-day-marangu-trek','<div style=\'font-family:Arial,sans-serif;\'><h1 style=\'color:#FF6B35; font-size:28px; margin:0 0 10px 0;\'>Most Accessible Kilimanjaro Route</h1><p style=\'font-size:15px; color:#555; margin:15px 0; line-height:1.8;\'>The most accessible route with hut accommodations. Coca-Cola Route offers gradual acclimatization through rainforest, moorland, and alpine zones to Uhuru Peak.</p><div style=\'background:#f9f5ec; padding:12px; border-radius:6px; margin:20px 0; border-left:4px solid #FF6B35;\'><strong>Highlights:</strong><br><span>Most Accessible • Rainforest Trek • Hut Accommodations • Gradual Acclimatization • Maundi Crater Option • Summit Sunrise</span></div><h3 style=\'color:#2ECC71; margin:25px 0 10px 0; border-bottom:2px solid #2ECC71; padding-bottom:8px;\'>✓ What\'s Included</h3><p>Licensed guides • Porters • All meals • Mountain huts • Park fees • Emergency oxygen • Summit certificate • Cooking equipment • Hot water</p><h3 style=\'color:#E74C3C; margin:25px 0 10px 0; border-bottom:2px solid #E74C3C; padding-bottom:8px;\'>✗ What\'s NOT Included</h3><p>International flights • Travel insurance REQUIRED • Personal gear • Tips ($100-150) • Alcohol • Pre-trek accommodation • Post-trek accommodation</p></div>',NULL,NULL,'Multi-day Trek package - 5 days from Mount Kilimanjaro','1','13','Mount Kilimanjaro',NULL,NULL,NULL,NULL,NULL,NULL,'995.00',NULL,'50','1','2',NULL,NULL,NULL,NULL,NULL,NULL,'[{\"title\":\"Why is Marangu called the Coca-Cola Route?\",\"content\":\"It has hut accommodations (Mandara, Horombo, Kibo) instead of camping. More comfort and warm beds at night. Historically most popular route.\"},{\"title\":\"What is the success rate?\",\"content\":\"70% for 5-day. Higher with 6-day. Success depends on fitness, acclimatization, and individual body response to altitude.\"},{\"title\":\"Is 5 days enough for acclimatization?\",\"content\":\"It\'s tight but works if you arrive pre-acclimatized. Many choose 6-day version (same route) for better altitude adaptation.\"},{\"title\":\"What\'s included in hut accommodations?\",\"content\":\"Basic but comfortable. Bunk beds with blankets, shared bathrooms. Hot water for washing provided. Meals cooked at hut. Simple but warm shelter.\"},{\"title\":\"How hard is the summit climb?\",\"content\":\"Very challenging. Midnight start, thin air (50% of sea level oxygen), steep ascent. Mostly mental battle. Rest\\/acclimatization days help prepare.\"}]','publish',NULL,'9',NULL,NULL,NULL,NULL,'2026-05-31 17:08:05','2026-05-31 17:08:05','1','0',NULL,NULL,NULL,'[\"Licensed mountain guides\",\"Porters (one per 2 trekkers)\",\"Sleeping bag and mattress\",\"All meals on mountain\",\"Mountain hut accommodations\",\"Park entrance fees\",\"Emergency oxygen available\",\"Summit certificates\",\"Cooking and dining equipment\",\"Hot water for washing\",\"First aid and health monitoring\",\"Transport to\\/from gate\"]','[\"International flights\",\"Travel insurance (REQUIRED)\",\"Personal climbing gear (available to rent)\",\"Tips for guides\\/porters ($100-150 suggested)\",\"Alcohol\",\"Pre-trek accommodation\",\"Post-trek accommodation\",\"Personal medications\"]','[{\"title\":\"Day 1: Marangu Gate to Mandara Hut\",\"desc\":\"Rainforest trek & registration\",\"content\":\"Morning pickup from hotel. Register at Marangu Gate (1,844m). Trek through lush rainforest. See colobus monkeys. Arrive at Mandara Hut (2,700m). Afternoon rest and acclimatization.\"},{\"title\":\"Day 2: Mandara to Horombo Hut\",\"desc\":\"Ascend to moorland\",\"content\":\"Leave rainforest behind. Ascend onto open moorland with spectacular views of Mawenzi and Kibo peaks. Giant lobelias and groundsels dot landscape. Arrive at Horombo Hut (3,720m).\"},{\"title\":\"Day 3: Horombo to Kibo Hut\",\"desc\":\"Cross the Saddle\",\"content\":\"Trek across the barren saddle between Kibo and Mawenzi. Volcanic landscape, sparse vegetation. Arrive at Kibo Hut (4,703m). Rest for the night and evening prep.\"},{\"title\":\"Day 4: Summit Attempt\",\"desc\":\"Uhuru Peak & descent\",\"content\":\"Pre-dawn start (12am). Climb toward Uhuru Peak. Arrive at Uhuru Peak (5,895m) for sunrise. Descend back to Horombo Hut. Celebrate with guides and crew.\"},{\"title\":\"Day 5: Descent to Marangu Gate\",\"desc\":\"Final descent through forest\",\"content\":\"Descend through moorland and forest back to Marangu Gate. Receive summit certificates. Transfer to hotel in Moshi. Rest and recover from your achievement.\"}]',NULL,NULL,NULL,NULL,NULL,'9',NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,'0');
INSERT INTO `bc_tours` (id,title,slug,content,image_id,banner_image_id,short_desc,category_id,location_id,address,map_lat,map_lng,map_zoom,is_featured,gallery,video,price,sale_price,duration,time_slot,zone,activity_type,available_months,available_days,tsokanew_id,min_people,max_people,faqs,status,publish_date,create_user,update_user,deleted_at,origin_id,lang,created_at,updated_at,default_state,enable_fixed_date,start_date,end_date,last_booking_date,include,exclude,itinerary,review_score,ical_import_url,enable_service_fee,service_fee,surrounding,author_id,booking_type,limit_type,capacity_type,capacity,pass_exprire_type,pass_exprire_at,pass_valid_for,date_select_type,min_day_before_booking,is_package) VALUES ('417','6-Day Machame Trek','6-day-machame-trek','<div style=\'font-family:Arial,sans-serif;\'><h1 style=\'color:#FF6B35; font-size:28px; margin:0 0 10px 0;\'>The Popular South Circuit Route</h1><p style=\'font-size:15px; color:#555; margin:15px 0; line-height:1.8;\'>The scenic Machame Route features diverse ecosystems and excellent acclimatization profile. The South Circuit descent ensures better altitude adaptation and higher summit success.</p><div style=\'background:#f9f5ec; padding:12px; border-radius:6px; margin:20px 0; border-left:4px solid #FF6B35;\'><strong>Highlights:</strong><br><span>South Circuit Route • Diverse Landscapes • Better Success Rate • Scenic Views • Challenging Hike • Rainforest to Alpine • Barranco Wall Adventure</span></div><h3 style=\'color:#2ECC71; margin:25px 0 10px 0; border-bottom:2px solid #2ECC71; padding-bottom:8px;\'>✓ What\'s Included</h3><p>Licensed guides • Professional porters • Sleeping bag and mattress • All meals • Mountain huts • Park fees • Emergency oxygen • Summit certificate • Cooking equipment • Hot water</p><h3 style=\'color:#E74C3C; margin:25px 0 10px 0; border-bottom:2px solid #E74C3C; padding-bottom:8px;\'>✗ What\'s NOT Included</h3><p>International flights • Travel insurance REQUIRED • Personal gear • Tips ($150-200) • Alcohol • Pre-trek accommodation • Post-trek accommodation</p></div>',NULL,NULL,'Multi-day Trek package - 6 days from Mount Kilimanjaro','1','13','Mount Kilimanjaro',NULL,NULL,NULL,NULL,NULL,NULL,'1195.00',NULL,'60','1','2',NULL,NULL,NULL,NULL,NULL,NULL,'[{\"title\":\"What makes Machame special?\",\"content\":\"Scenic variety! Rainforest, moorland, alpine. South Circuit provides excellent acclimatization. Higher success rate (80%) than shorter routes.\"},{\"title\":\"How hard is the Barranco Wall?\",\"content\":\"Steep and exposed but non-technical. No ropes needed. Scrambling with chains\\/handholds. 4-5 hours. Challenging but achievable with good fitness.\"},{\"title\":\"Is 6 days better than 5?\",\"content\":\"Much better! Extra day at Shira Plateau significantly improves acclimatization. 80% success vs 70% on shorter routes. Well worth the extra day.\"},{\"title\":\"What\'s the daily hiking time?\",\"content\":\"Varies: Day 1 (4-6 hours), Days 2-4 (4-6 hours), Day 5 (3-4 hours), Day 6 (12+ hours with long descent). Mostly moderate pace.\"}]','publish',NULL,'9',NULL,NULL,NULL,NULL,'2026-05-31 17:08:05','2026-05-31 17:08:05','1','0',NULL,NULL,NULL,'[\"Licensed mountain guides\",\"Professional porters\",\"Sleeping bag and mattress\",\"All meals prepared fresh\",\"Mountain hut\\/camp accommodations\",\"Park entrance fees\",\"Emergency oxygen\",\"Summit certificates\",\"Cooking and dining setup\",\"Hot water provided\",\"First aid and monitoring\",\"Rescue insurance\"]','[\"International flights\",\"Travel insurance (REQUIRED)\",\"Personal climbing gear (rent available)\",\"Tips ($150-200 suggested)\",\"Alcohol\",\"Pre-trek accommodation\",\"Post-trek accommodation\",\"Personal medications\"]','[{\"title\":\"Day 1: Machame Gate to Machame Camp\",\"desc\":\"Rainforest entry\",\"content\":\"Drive to Machame Gate (1,800m). Register and begin trek through dense rainforest. See exotic birds, monkeys, lush vegetation. Arrive at Machame Camp (2,643m). Rest and acclimatize.\"},{\"title\":\"Day 2: Machame to Shira Camp\",\"desc\":\"Ascend rocky ridge to plateau\",\"content\":\"Ascend a rocky ridge through moorland. Leave rainforest behind. Enter Shira Plateau (3,840m). Diverse landscape with volcanic features. Arrive at Shira Camp (3,840m).\"},{\"title\":\"Day 3: Shira to Lava Tower to Barranco\",\"desc\":\"Lava Tower acclimatization hike\",\"content\":\"Important acclimatization day. Hike to Lava Tower (4,600m) for altitude exposure. Descend to Barranco Camp (3,960m). \\\\\\\"Climb high, sleep low\\\\\\\" strategy for better adaptation.\"},{\"title\":\"Day 4: Barranco Wall Climb\",\"desc\":\"Climb Barranco Wall\",\"content\":\"Steep Barranco Wall climb (4-5 hours). Non-technical but challenging scrambling with chains. Reward is stunning views. Camp at Karanga (4,035m).\"},{\"title\":\"Day 5: Barafu Base Camp\",\"desc\":\"Final ascent to summit camp\",\"content\":\"Continue climbing to Barafu Camp (4,640m). Complete the South Circuit route. Rest and prepare for summit attempt. Early dinner and sleep prep.\"},{\"title\":\"Day 6: Summit & Descent\",\"desc\":\"Uhuru Peak sunrise\",\"content\":\"Midnight start. Climb via Stella Point to Uhuru Peak (5,895m). Sunrise celebration. Descend to Mweka Camp (3,100m). Long 11km descent through forest.\"}]',NULL,NULL,NULL,NULL,NULL,'9',NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,'0');
