INSERT INTO `bc_tours` (id,title,slug,content,image_id,banner_image_id,short_desc,category_id,location_id,address,map_lat,map_lng,map_zoom,is_featured,gallery,video,price,sale_price,duration,time_slot,zone,activity_type,available_months,available_days,tsokanew_id,min_people,max_people,faqs,status,publish_date,create_user,update_user,deleted_at,origin_id,lang,created_at,updated_at,default_state,enable_fixed_date,start_date,end_date,last_booking_date,include,exclude,itinerary,review_score,ical_import_url,enable_service_fee,service_fee,surrounding,author_id,booking_type,limit_type,capacity_type,capacity,pass_exprire_type,pass_exprire_at,pass_valid_for,date_select_type,min_day_before_booking,is_package) VALUES ('1','Full Day Chobe Trip — Botswana','chobe-day-trip-1','<p>Full day at the Mara River area watching for the wildebeest migration crossing.</p>','440',NULL,'Full day at the Mara River area watching for the wildebeest migration crossing.',NULL,'6',NULL,NULL,NULL,NULL,NULL,NULL,NULL,'175.00',NULL,'10','1','4','Safari',NULL,NULL,NULL,NULL,NULL,'[{\"title\":\"What\'s the difference from game drive?\",\"content\":\"Safaris combine driving, walking, and observation. More immersive nature experience with expert ecology education.\"},{\"title\":\"How many animals will we see?\",\"content\":\"Depends on season and location. Expect diverse wildlife sightings throughout the day.\"},{\"title\":\"Is this physically demanding?\",\"content\":\"Mostly sitting in vehicle. Optional walking safari elements (easy). Rest breaks throughout.\"},{\"title\":\"Best time for safari?\",\"content\":\"Dry season (June-October) offers best visibility and animal activity. Wet season has lush landscapes.\"},{\"title\":\"What equipment needed?\",\"content\":\"Binoculars, camera, sun protection, neutral clothing, hat, water bottle, notebook for wildlife tracking.\"}]','publish',NULL,'7',NULL,NULL,NULL,NULL,'2026-05-26 00:23:26','2026-05-26 00:23:26','1','0',NULL,NULL,NULL,'[{\"title\":\"Naturalist