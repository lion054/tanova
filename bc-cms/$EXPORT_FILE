INSERT INTO `bc_tours` (id,title,slug,content,image_id,banner_image_id,short_desc,category_id,location_id,address,map_lat,map_lng,map_zoom,is_featured,gallery,video,price,sale_price,duration,time_slot,zone,activity_type,available_months,available_days,tsokanew_id,min_people,max_people,faqs,status,publish_date,create_user,update_user,deleted_at,origin_id,lang,created_at,updated_at,default_state,enable_fixed_date,start_date,end_date,last_booking_date,include,exclude,itinerary,review_score,ical_import_url,enable_service_fee,service_fee,surrounding,author_id,booking_type,limit_type,capacity_type,capacity,pass_exprire_type,pass_exprire_at,pass_valid_for,date_select_type,min_day_before_booking,is_package) VALUES ('30','Boma Dinner — Taste of Zimbabwe','boma-dinner-75','<p>The Boma is one of Victoria Falls\'s most celebrated cultural dining experiences. Gather around a traditional African boma (enclosure) for a feast of Zimbabwean and regional cuisine — sadza, game meats, stews, and grilled specialities cooked on open fires. Live marimba music, traditional dancers, and a genuine village atmosphere make this far more than a meal. A wonderful way to connect with Zimbabwean culture and flavour.</p>','466',NULL,'Authentic Zimbabwean cultural dinner in a traditional boma — live music, dancing, and local cuisine around the fire.',NULL,'6',NULL,NULL,NULL,NULL,NULL,NULL,NULL,'70.00',NULL,'4','3','1','Cultural',NULL,NULL,NULL,NULL,NULL,'[{\"title\":\"Is this respectful tourism?\",\"content\":\"Yes! Communities invite visitors. Revenue supports local education. We emphasize respectful interaction and ethical photography.\"},{\"title\":\"Can I take photos?\",\"content\":\"Yes, but ask permission first. Some families may request donation for photos. Respect sacred spaces.\"},{\"title\":\"What should I wear?\",\"content\":\"Respectful clothing\\u2014covered shoulders\\/knees. Avoid revealing clothes. Wear comfortably but conservatively.\"},{\"title\":\"Is food safe?\",\"content\":\"Absolutely. Communities prepare carefully for visitors. Food is fresh and hygienic. Mention dietary concerns to guide.\"},{\"title\":\"Can I buy souvenirs?\",\"content\":\"Yes! Purchases support artisans directly. Guides help find authentic items and fair prices.\"}]','publish',NULL,'7',NULL,NULL,NULL,NULL,'2026-05-26 00:23:26','2026-05-26 00:23:26','1','0',NULL,NULL,NULL,'[{\"title\":\"Cultural guide\"},{\"title\":\"Community tour\"},{\"title\":\"Traditional meals\"},{\"title\":\"Craft demonstrations\"},{\"title\":\"Cultural activities\"},{\"title\":\"Transport\"},{\"title\":\"Market access\"}]','[{\"title\":\"Souvenir purchases\"},{\"title\":\"Tips\\/gratuities\"},{\"title\":\"Alcohol\"},{\"title\":\"Personal items\"}]','[{\"title\":\"Day 1: Boma Dinner \\u2014 Taste of Zimbabwe\",\"desc\":\"Authentic Zimbabwean cultural dinner in a traditional boma \\u2014 live music, dancing, and local cuisine around the fire.\",\"content\":\"Village visit with welcome \\u2022 Guided tour & cultural explanation \\u2022 Craft demonstrations \\u2022 Traditional meal \\u2022 Cultural activities (dance, stories) \\u2022 Market time \\u2022 Community Q&A \\u2022 10 hours\",\"image_id\":466}]',NULL,NULL,NULL,NULL,NULL,'7',NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,'0');
