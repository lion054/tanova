INSERT INTO `bc_tour_translations` (id,origin_id,locale,title,slug,content,short_desc,address,faqs,create_user,update_user,created_at,updated_at,include,exclude,itinerary,surrounding) VALUES ('323','15','en','Fishing Trip','fishing-trip-19','We introduce Fishing on the mighty Zambezi River all year round for Tiger, Bream, Nembwe and the Catfish, just to mention a few from the 75 known species found in the Zambezi River.

We offer fly fishing, Spinning, Trolling and drift bait or live bait fishing from our fishing pontoon vessel with a maximum of 8 passengers. The upper Zambezi is a Mecca for fly fisherman over the months of May, June and July normally you would catch the Predatory fish such as the Tiger fish and Nembwe although when the water level drops from the month of July the three spotted bream and the thin face will regularly take a fly in the rock pools above Kandahar Island.
Spinning for Tiger fish and Nembwe from August to December when the water is clear will generally have good results, spinning closer to the shore and islands will yield good results. Some bream will take a spinning lure.
Trolling is mainly done for the Tiger fish although the Sharp toothed catfish will take a Rappala. Trolling is mainly done in deep water when the water gets clear and the big solitary tiger fish retreat to deepwater this is due to other predators like the Fish eagle and crocodiles preying on them.

Just remember the Zambezi River is a constantly changing environment therefore fish constantly change their fishing habits according to factors such as water levels, water clarity and food supplies. We therefore always change our fishing methods accordingly for our Anglers to have a high success rate. In the winter months the Pink Happy bream is a strong favourite with the local Victoria Falls community and put up a good fight. Most Anglers though tend to underestimate the Catfish or known locally as the Muramba as a good game fish, it has sizes recorded up to 40 kilograms and puts up a good fight.

We practice a catch and release policy, although a badly hooked one maybe taken out. We encourage our anglers to enjoy the Bird life which is amazing on the upper Zambezi and so is the Game with regular sightings of Hippos and Elephants. Watch out for the crocodiles, every 10 metres in the Zambezi account for one of these underwater dragons! Otherwise enjoy the fishing and sit back and enjoy natures marvels on the upper Zambezi.',NULL,NULL,NULL,'7',NULL,'2026-05-26 00:23:26','2026-05-26 00:23:26',NULL,NULL,NULL,NULL);
INSERT INTO `bc_tour_translations` (id,origin_id,locale,title,slug,content,short_desc,address,faqs,create_user,update_user,created_at,updated_at,include,exclude,itinerary,surrounding) VALUES ('324','16','en','Hwange National Park — Full Day Safari','hwange-day-trip-22','<p>Zimbabwe\'s premier national park, Hwange is home to massive elephant herds alongside lion, leopard, wild dog, and over 400 bird species. Full-day excursion with morning and afternoon game drives and a picnic lunch in the bush.</p>',NULL,NULL,NULL,'7',NULL,'2026-05-26 00:23:26','2026-05-26 00:23:26',NULL,NULL,NULL,NULL);
