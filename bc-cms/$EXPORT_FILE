INSERT INTO `bc_tours` (id,title,slug,content,image_id,banner_image_id,short_desc,category_id,location_id,address,map_lat,map_lng,map_zoom,is_featured,gallery,video,price,sale_price,duration,time_slot,zone,activity_type,available_months,available_days,tsokanew_id,min_people,max_people,faqs,status,publish_date,create_user,update_user,deleted_at,origin_id,lang,created_at,updated_at,default_state,enable_fixed_date,start_date,end_date,last_booking_date,include,exclude,itinerary,review_score,ical_import_url,enable_service_fee,service_fee,surrounding,author_id,booking_type,limit_type,capacity_type,capacity,pass_exprire_type,pass_exprire_at,pass_valid_for,date_select_type,min_day_before_booking,is_package) VALUES ('266','Homestead Lunch — Traditional Zimbabwean Meal','homestead-lunch-victoria-falls','<p>Sit down to a home-cooked Zimbabwean meal prepared by a local family in their homestead near Victoria Falls. Dishes of sadza (maize meal), stewed meat, roasted pumpkin, and leafy greens are prepared fresh using traditional recipes passed down through generations. Eat together around the family table and share stories, laughter, and genuine cultural hospitality. A deeply authentic taste of Zimbabwe beyond the hotel dining room.</p>',NULL,NULL,'Home-cooked traditional Zimbabwean lunch at a local homestead — real food, real families, real culture.',NULL,'6',NULL,NULL,NULL,NULL,NULL,NULL,NULL,'40.00',NULL,'2','1','2','Cultural',NULL,NULL,NULL,NULL,NULL,'[{\"title\":\"Is this respectful tourism?\",\"content\":\"Yes! Communities invite visitors. Revenue supports local education. We emphasize respectful interaction and ethical photography.\"},{\"title\":\"Can I take photos?\",\"content\":\"Yes, but ask permission first. Some families may request donation for photos. Respect sacred spaces.\"},{\"title\":\"What should I wear?\",\"content\":\"Respectful clothing\\u2014covered shoulders\\/knees. Avoid revealing clothes. Wear comfortably but conservatively.\"},{\"title\":\"Is food safe?\",\"content\":\"Absolutely. Communities prepare carefully for visitors. Food is fresh and hygienic. Mention dietary concerns to guide.\"},{\"title\":\"Can I buy souvenirs?\",\"content\":\"Yes! Purchases support artisans directly. Guides help find authentic items and fair prices.\"}]','publish',NULL,'7',NULL,NULL,NULL,NULL,'2026-05-26 00:40:14','2026-05-26 00:40:14','1','0',NULL,NULL,NULL,'[{\"title\":\"Cultural guide\"},{\"title\":\"Community tour\"},{\"title\":\"Traditional meals\"},{\"title\":\"Craft demonstrations\"},{\"title\":\"Cultural activities\"},{\"title\":\"Transport\"},{\"title\":\"Market access\"}]','[{\"title\":\"Souvenir purchases\"},{\"title\":\"Tips\\/gratuities\"},{\"title\":\"Alcohol\"},{\"title\":\"Personal items\"}]','[{\"title\":\"Day 1: Homestead Lunch \\u2014 Traditional Zimbabwean Meal\",\"desc\":\"Home-cooked traditional Zimbabwean lunch at a local homestead \\u2014 real food, real families, real culture.\",\"content\":\"Village visit with welcome \\u2022 Guided tour & cultural explanation \\u2022 Craft demonstrations \\u2022 Traditional meal \\u2022 Cultural activities (dance, stories) \\u2022 Market time \\u2022 Community Q&A \\u2022 10 hours\",\"image_id\":null}]',NULL,NULL,NULL,NULL,NULL,'7',NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,'0');
INSERT INTO `bc_tours` (id,title,slug,content,image_id,banner_image_id,short_desc,category_id,location_id,address,map_lat,map_lng,map_zoom,is_featured,gallery,video,price,sale_price,duration,time_slot,zone,activity_type,available_months,available_days,tsokanew_id,min_people,max_people,faqs,status,publish_date,create_user,update_user,deleted_at,origin_id,lang,created_at,updated_at,default_state,enable_fixed_date,start_date,end_date,last_booking_date,include,exclude,itinerary,review_score,ical_import_url,enable_service_fee,service_fee,surrounding,author_id,booking_type,limit_type,capacity_type,capacity,pass_exprire_type,pass_exprire_at,pass_valid_for,date_select_type,min_day_before_booking,is_package) VALUES ('267','Night Drive or Bush Dinner — Private Game Drive','night-drive-bush-dinner-victoria-falls','<p>As the sun sets over the Zambezi, the African bush transforms into a completely different world. Join a private game drive through the Victoria Falls Game Reserve at night, spotlighting nocturnal wildlife including lion, leopard, civet, genet, and the elusive aardvark. Alternatively, choose the Bush Dinner experience — a private table set in the wilderness under the stars, with a fine three-course dinner and the sounds of the African night surrounding you. A profound and magical evening.</p>',NULL,NULL,'Private night game drive or exclusive bush dinner under the stars — experience the African night in style.',NULL,'6',NULL,NULL,NULL,NULL,NULL,NULL,NULL,'190.00',NULL,'3','2','2','Safari',NULL,NULL,NULL,NULL,NULL,'[{\"title\":\"What\'s the difference from game drive?\",\"content\":\"Safaris combine driving, walking, and observation. More immersive nature experience with expert ecology education.\"},{\"title\":\"How many animals will we see?\",\"content\":\"Depends on season and location. Expect diverse wildlife sightings throughout the day.\"},{\"title\":\"Is this physically demanding?\",\"content\":\"Mostly sitting in vehicle. Optional walking safari elements (easy). Rest breaks throughout.\"},{\"title\":\"Best time for safari?\",\"content\":\"Dry season (June-October) offers best visibility and animal activity. Wet season has lush landscapes.\"},{\"title\":\"What equipment needed?\",\"content\":\"Binoculars, camera, sun protection, neutral clothing, hat, water bottle, notebook for wildlife tracking.\"}]','publish',NULL,'7',NULL,NULL,NULL,NULL,'2026-05-26 00:40:14','2026-05-26 00:40:14','1','0',NULL,NULL,NULL,'[{\"title\":\"Naturalist guide\"},{\"title\":\"All meals\"},{\"title\":\"Binoculars\"},{\"title\":\"Safari vehicle\"},{\"title\":\"Wildlife spotting\"},{\"title\":\"Photography support\"},{\"title\":\"Water & refreshments\"}]','[{\"title\":\"Equipment rental\"},{\"title\":\"Alcohol\"},{\"title\":\"Tips\"},{\"title\":\"Personal gear\"},{\"title\":\"Travel insurance\"}]','[{\"title\":\"Day 1: Night Drive or Bush Dinner \\u2014 Private Game Drive\",\"desc\":\"Private night game drive or exclusive bush dinner under the stars \\u2014 experience the African night in style.\",\"content\":\"Safari experience \\u2022 6am breakfast & briefing \\u2022 Early morning drives \\u2022 Lunch at camp \\u2022 Afternoon game viewing \\u2022 Evening sunset safari \\u2022 Dinner & debrief \\u2022 Professional naturalist guides \\u2022 10 hours\",\"image_id\":null}]',NULL,NULL,NULL,NULL,NULL,'7',NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,'0');
