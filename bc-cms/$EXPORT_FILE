INSERT INTO `bc_tour_translations` (id,origin_id,locale,title,slug,content,short_desc,address,faqs,create_user,update_user,created_at,updated_at,include,exclude,itinerary,surrounding) VALUES ('565','257','en','Tandem Gorge Swing','tandem-gorge-swing-victoria-falls','<p>Double the thrill — share the jump with a friend on the Tandem Gorge Swing. Both of you are harnessed together and launched simultaneously off the 70-metre platform above the Batoka Gorge.</p>',NULL,NULL,NULL,'7',NULL,'2026-05-26 00:40:14','2026-05-26 00:40:14',NULL,NULL,NULL,NULL);
INSERT INTO `bc_tour_translations` (id,origin_id,locale,title,slug,content,short_desc,address,faqs,create_user,update_user,created_at,updated_at,include,exclude,itinerary,surrounding) VALUES ('566','258','en','Tandem Zip Line — Victoria Falls Gorge','tandem-zip-line-victoria-falls','<p>Share the rush of the Victoria Falls gorge zipline with a friend on dual parallel cables across the gorge. Pure adrenaline, doubled.</p>',NULL,NULL,NULL,'7',NULL,'2026-05-26 00:40:14','2026-05-26 00:40:14',NULL,NULL,NULL,NULL);
INSERT INTO `bc_tour_translations` (id,origin_id,locale,title,slug,content,short_desc,address,faqs,create_user,update_user,created_at,updated_at,include,exclude,itinerary,surrounding) VALUES ('567','259','en','Rafting & Gorge Swing — The Ultimate Combo','rafting-gorge-swing-combo-victoria-falls','<p>Full-day Grade 5 white water rafting through the Batoka Gorge followed by the iconic 70m Gorge Swing. The complete Zambezi adrenaline experience in one day.</p>',NULL,NULL,NULL,'7',NULL,'2026-05-26 00:40:14','2026-05-26 00:40:14',NULL,NULL,NULL,NULL);
INSERT INTO `bc_tour_translations` (id,origin_id,locale,title,slug,content,short_desc,address,faqs,create_user,update_user,created_at,updated_at,include,exclude,itinerary,surrounding) VALUES ('568','260','en','Luxury Zambezi Royal Cruise','luxury-zambezi-royal-cruise','<p>Premium butler-service sunset cruise on the Zambezi River — gourmet canapés, fine cocktails, and exclusive luxury as the African sun sets.</p>',NULL,NULL,NULL,'7',NULL,'2026-05-26 00:40:14','2026-05-26 00:40:14',NULL,NULL,NULL,NULL);
INSERT INTO `bc_tour_translations` (id,origin_id,locale,title,slug,content,short_desc,address,faqs,create_user,update_user,created_at,updated_at,include,exclude,itinerary,surrounding) VALUES ('569','261','en','Livingstone Island Breakfast','livingstone-island-breakfast','<p>Breakfast on the edge of Victoria Falls at the historic Livingstone Island — where the explorer first witnessed Mosi-oa-Tunya. Available in Green and High season rates.</p>',NULL,NULL,NULL,'7',NULL,'2026-05-26 00:40:14','2026-05-26 00:40:14',NULL,NULL,NULL,NULL);
INSERT INTO `bc_tour_translations` (id,origin_id,locale,title,slug,content,short_desc,address,faqs,create_user,update_user,created_at,updated_at,include,exclude,itinerary,surrounding) VALUES ('570','262','en','Livingstone Island Lunch','livingstone-island-lunch','<p>Three-course gourmet lunch on Livingstone Island at the lip of Victoria Falls. The most spectacular dining table in Africa, with Green and High season pricing.</p>',NULL,NULL,NULL,'7',NULL,'2026-05-26 00:40:14','2026-05-26 00:40:14',NULL,NULL,NULL,NULL);
