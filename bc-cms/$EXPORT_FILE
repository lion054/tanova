INSERT INTO `bc_location_translations` (id,origin_id,locale,name,content,create_user,update_user,created_at,updated_at,trip_ideas,general_info) VALUES ('6','6','en','Victoria Falls','Victoria Falls is a natural wonder located on the Zambezi River, bordering Zambia and Zimbabwe. Also known as Mosi-oa-Tunya, meaning \"the smoke that thunders\", the falls are one of the largest and most spectacular waterfalls in the world. With a width of over 1.7 kilometers and a height of 108 meters, the falls produce a magnificent curtain of mist and offer breathtaking views of the surrounding rainforest and gorge. Victoria Falls is a popular tourist destination, known for its natural beauty and adrenaline-inducing activities such as bungee jumping, white-water rafting, and helicopter tours.','6','6','2026-05-24 00:57:03','2026-05-24 01:22:56',NULL,'Victoria Falls is made of five different falls and 4 are in Zimbabwe and one is in the bordering country of Zambia.');
INSERT INTO `bc_location_translations` (id,origin_id,locale,name,content,create_user,update_user,created_at,updated_at,trip_ideas,general_info) VALUES ('7','7','en','Nyanga','It is located in Nyanga District, Manicaland Province, in Eastern Highland of Zimbabwe, along the international border with Mozambique. This location lies immediately north of Nyanga National Park in the Eastern Highlands, about 115 kilometres (71 mi), by road, north of Mutare, the third large city.','6','6','2026-05-24 00:57:03','2026-05-24 01:22:56',NULL,'Nyanga, originally known as Inyanga, is a town in Zimbabwe.');
INSERT INTO `bc_location_translations` (id,origin_id,locale,name,content,create_user,update_user,created_at,updated_at,trip_ideas,general_info) VALUES ('8','8','en','Harare','Harare, the capital and largest city of Zimbabwe, is a bustling metropolis that serves as the country\'s commercial and cultural hub. The city offers a unique blend of modern architecture, colonial-era buildings, and vibrant local markets. Visitors can explore world-class museums including the National Gallery of Zimbabwe, enjoy lush botanical gardens, and experience the city\'s thriving arts scene. Harare serves as an excellent base for exploring Zimbabwe\'s attractions while offering its own array of dining, shopping, and entertainment options.','6','6','2026-05-24 00:57:03','2026-05-24 01:22:56',NULL,'Zimbabwe\'s vibrant capital city blending modern amenities with rich cultural heritage');
INSERT INTO `bc_location_translations` (id,origin_id,locale,name,content,create_user,update_user,created_at,updated_at,trip_ideas,general_info) VALUES ('9','9','en','Cape Town','Cape Town is a vibrant coastal city located in South Africa, nestled between the Atlantic Ocean and the iconic Table Mountain. Known for its stunning scenery, rich history, and diverse culture, Cape Town attracts visitors from around the world. The city\'s highlights include the Victoria & Alfred Waterfront, a bustling hub of restaurants, shops, and entertainment; the Kirstenbosch National Botanical Garden, showcasing the unique flora of the Cape region; and Robben Island, a UNESCO World Heritage Site and former prison where Nelson Mandela was held for 18 years. Cape Town is also famous for its stunning beaches, including Clifton and Camps Bay, which offer crystal-clear waters and scenic views.','6','6','2026-05-24 00:57:03','2026-05-24 01:22:56',NULL,'Vibrant coastal city nestled between the Atlantic Ocean and Table Mountain.');
INSERT INTO `bc_location_translations` (id,origin_id,locale,name,content,create_user,update_user,created_at,updated_at,trip_ideas,general_info) VALUES ('10','10','en','Dubai','Dubai is a modern metropolis located in the United Arab Emirates, known for its impressive skyline, luxurious shopping, and extravagant attractions. The city features some of the world\'s tallest skyscrapers, including the iconic Burj Khalifa, as well as stunning man-made islands such as the Palm Jumeirah. Dubai is also home to some of the world\'s most luxurious shopping malls, such as the Dubai Mall, which features over 1,200 stores and a range of entertainment options, including an aquarium and an ice rink. The city is also famous for its entertainment and leisure offerings, including indoor skiing at Ski Dubai, thrilling water parks such as Atlantis Aquaventure, and adrenaline-fueled experiences such as skydiving over the Palm Jumeirah.','6','6','2026-05-24 00:57:03','2026-05-24 01:22:56',NULL,'Ultra-modern city of iconic skyscrapers, luxury shopping, and world-class entertainment.');
INSERT INTO `bc_location_translations` (id,origin_id,locale,name,content,create_user,update_user,created_at,updated_at,trip_ideas,general_info) VALUES ('11','11','en','Zanzibar','Zanzibar is a tropical archipelago located off the coast of Tanzania, known for its pristine beaches, turquoise waters, and rich cultural heritage. The islands offer a unique blend of African, Arab, and Indian influences, making it a fascinating destination to explore. Highlights of Zanzibar include the Stone Town, a UNESCO World Heritage Site and the historic heart of the island, featuring winding alleys, bustling markets, and beautiful architecture. The island\'s beaches are also a major draw, with soft white sand, clear waters, and opportunities for water sports such as snorkeling, diving, and fishing. Zanzibar is also known for its spice plantations, where visitors can learn about the island\'s history as a major center of the spice trade.','6','6','2026-05-24 00:57:03','2026-05-24 01:22:56',NULL,'Tropical archipelago of pristine beaches, Stone Town, and vibrant spice heritage.');
INSERT INTO `bc_location_translations` (id,origin_id,locale,name,content,create_user,update_user,created_at,updated_at,trip_ideas,general_info) VALUES ('12','12','en','Singapore City','Singapore is a vibrant city-state in Southeast Asia known for its impressive skyline, diverse culture, and culinary delights. Highlights include the Marina Bay Sands complex, Gardens by the Bay, and a vibrant food and shopping scene. Singapore offers a unique blend of modernity and tradition, making it a must-visit destination in Southeast Asia.','6','6','2026-05-24 00:57:03','2026-05-24 01:22:56',NULL,'A futuristic city-state blending world-class skyline, cuisine, and multicultural heritage.');
