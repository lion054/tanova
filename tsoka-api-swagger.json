    "/concierge/conversations/{id}": {
      "get": {
        "summary": "Get Conversation Details",
        "description": "Retrieve full conversation including all messages and current conversation state.",
        "tags": ["Concierge"],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "example": 42
          },
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 1
            },
            "description": "Paginate through messages (50 per page)"
          }
        ],
        "responses": {
          "200": {
            "description": "Conversation with all messages",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "conversation": {
                      "$ref": "#/components/schemas/ChatbotConversation"
                    },
                    "messages": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/ChatMessage"
                      }
                    },
                    "pagination": {
                      "type": "object",
                      "properties": {
                        "current_page": {
                          "type": "integer"
                        },
                        "last_page": {
                          "type": "integer"
                        },
                        "total": {
                          "type": "integer"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "403": {
            "description": "Forbidden - conversation belongs to another vendor"
          },
          "404": {
            "description": "Conversation not found"
          }
        }
      }
    },
    "/concierge/message": {
      "post": {
        "summary": "Send Chatbot Message",
        "description": "Send a message to the AI chatbot. The bot handles multi-step conversation for trip planning: destination → dates → travelers → budget → generate itinerary. Also answers general travel questions. Rate limited: 60 messages/minute per vendor.",
        "tags": ["Concierge"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["guest_email", "message"],
                "properties": {
                  "guest_email": {
                    "type": "string",
                    "format": "email",
                    "example": "john@example.com",
                    "description": "Customer email (identifies or creates conversation)"
                  },
                  "guest_name": {
                    "type": "string",
                    "example": "John Doe",
                    "description": "Customer name (used if creating new conversation)"
                  },
                  "guest_phone": {
                    "type": "string",
                    "example": "+1234567890"
                  },
                  "message": {
                    "type": "string",
                    "example": "I want to plan a 5-day trip to Victoria Falls for 2 people with a $5000 budget",
                    "minLength": 1,
                    "maxLength": 2000
                  },
                  "channel": {
                    "type": "string",
                    "enum": ["web", "whatsapp", "facebook", "telegram"],
                    "default": "web"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Chatbot response received",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "conversation_id": {
                      "type": "integer",
                      "example": 42
                    },
                    "user_message": {
                      "$ref": "#/components/schemas/ChatMessage"
                    },
                    "assistant_message": {
                      "$ref": "#/components/schemas/ChatMessage"
                    },
                    "next_step": {
                      "type": "string",
                      "description": "What the bot is waiting for next",
                      "example": "dates",
                      "enum": ["destination", "dates", "travelers", "budget", "confirm", "generate", "completed"]
                    },
                    "trip_ready": {
                      "type": "boolean",
                      "description": "True when bot has all info to generate trip",
                      "example": false
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid request or message too long"
          },
          "429": {
            "description": "Rate limit exceeded (60 messages/min)"
          }
        }
      }
    },
    "/concierge/conversations/{id}/messages": {
      "post": {
        "summary": "Send Message (Deprecated)",
        "description": "DEPRECATED: Use /concierge/message instead. Send a message in a customer conversation.",
