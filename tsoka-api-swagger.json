                        },
                        "by_channel": {
                          "type": "object",
                          "properties": {
                            "web": {
                              "type": "integer",
                              "example": 30
                            },
                            "whatsapp": {
                              "type": "integer",
                              "example": 10
                            },
                            "facebook": {
                              "type": "integer",
                              "example": 2
                            },
                            "telegram": {
                              "type": "integer",
                              "example": 0
                            }
                          }
