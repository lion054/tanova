                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Message sent successfully"
          },
          "403": {
            "description": "Forbidden - conversation belongs to another vendor"
          }
        }
      }
    },
    "/concierge/statistics": {
      "get": {
        "summary": "Get Chatbot Statistics",
